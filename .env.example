# ─── Daktari Agent — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in only the values required for your environment.
# SECURITY INVARIANT: Never prefix Anthropic, OpenAI, or NVIDIA API keys with EXPO_PUBLIC_,
# as Expo embeds EXPO_PUBLIC_* variables in plaintext inside client bundles.

# ─── Mobile Companion UI (Public Client Config Only) ──────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=0.4.0

# ─── Server / Agent Runner Only (Never Exposed to Mobile Bundle) ──────────────
GAUNTLET_MODEL_PROVIDER=nvidia_nim
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
AFRICA_TALKING_API_KEY=your_africa_talking_key
AFRICA_TALKING_USERNAME=your_username
GOOGLE_CLOUD_PROJECT=
GCS_AUDIT_BUCKET=daktari-audit-telemetry
