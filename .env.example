# ─── Daktari Agent — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# For Railway: set these in the Railway dashboard > Variables tab.
# For Replit: set these in the Replit Secrets panel.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
# IMPORTANT: In production, proxy this through a backend — never expose in client
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── OpenAI (Whisper ASR) ─────────────────────────────────────────────────────
# Used for Swahili voice-to-text transcription
# Get from: https://platform.openai.com/api-keys
# Production path: replace with on-device Whisper via react-native-whisper
EXPO_PUBLIC_OPENAI_API_KEY=sk-your_openai_key_here

# ─── App Config ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development  # development | staging | production
EXPO_PUBLIC_APP_VERSION=0.4.0

# ─── Server-side only (Railway / Replit backend) ──────────────────────────────
# These are NOT prefixed EXPO_PUBLIC — they never go to the mobile client
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ANTHROPIC_API_KEY=sk-ant-your_key_here           # server-side Claude calls (USSD)
AFRICA_TALKING_API_KEY=your_africa_talking_key   # USSD webhook handler
AFRICA_TALKING_USERNAME=your_username
